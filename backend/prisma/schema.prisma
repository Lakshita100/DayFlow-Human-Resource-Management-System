generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveType {
  PAID
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  GENERATED
  PAID
}

// ============================================
// MODELS
// ============================================

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  prefix    String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees     Employee[]
  users         User[]
  yearlySerials YearlySerial[]
  payrolls      Payroll[]
}

model User {
  id                 String   @id @default(uuid())
  loginId            String   @unique @default("")
  email              String   @unique
  passwordHash       String
  role               Role     @default(EMPLOYEE)
  companyId          String?
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employee      Employee?
  notifications Notification[]

  @@index([loginId])
  @@index([email])
  @@index([companyId])
  @@index([companyId, email])
}

model Employee {
  id             String         @id @default(uuid())
  employeeId     String         @unique
  userId         String         @unique
  companyId      String?
  firstName      String
  lastName       String
  phone          String?
  department     String
  designation    String
  dateOfJoining  DateTime
  employmentType String         @default("FULL_TIME")
  status         EmployeeStatus @default(ACTIVE)
  profilePicture String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company          Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  privateInfo      EmployeePrivateInfo?
  skills           EmployeeSkill[]
  documents        EmployeeDocument[]
  attendance       Attendance[]
  timeOffRequests  TimeOff[]
  leaveAllocations LeaveAllocation[]
  salaryStructure  SalaryStructure?
  payrolls         Payroll[]

  @@index([employeeId])
  @@index([userId])
  @@index([companyId])
}

model YearlySerial {
  id         String @id @default(uuid())
  companyId  String
  year       Int
  lastSerial Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year])
}

model EmployeePrivateInfo {
  id                    String    @id @default(uuid())
  employeeId            String    @unique
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  country               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  employeeSkills EmployeeSkill[]
}

model EmployeeSkill {
  id          String  @id @default(uuid())
  employeeId  String
  skillId     String
  proficiency String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Float?
  extraHours Float?
  status     AttendanceStatus @default(ABSENT)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model TimeOff {
  id         String      @id @default(uuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model LeaveAllocation {
  id         String    @id @default(uuid())
  employeeId String
  type       LeaveType
  total      Int
  used       Int       @default(0)
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type, year])
  @@index([employeeId])
}

enum WageType {
  FIXED
}

enum CalculationType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum CalculationBasis {
  WAGE
  BASIC_SALARY
  GROSS_SALARY
}

// ============================================
// MODELS
// ============================================

model SalaryStructure {
  id                 String    @id @default(uuid())
  employeeId         String    @unique
  wageType           WageType  @default(FIXED)
  monthlyWage        Decimal   @default(0.00) @db.Decimal(12, 2)
  workingDaysPerWeek Int       @default(5)
  breakTimeHours     Decimal   @default(1.00) @db.Decimal(5, 2)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components       SalaryComponent[]
  pfConfiguration  PFConfiguration?
  taxConfiguration TaxConfiguration?
}

model SalaryComponent {
  id                String            @id @default(uuid())
  salaryStructureId String
  code              String
  name              String
  calculationType   CalculationType   @default(FIXED_AMOUNT)
  calculationBasis  CalculationBasis?
  value             Decimal           @default(0.00) @db.Decimal(12, 2)
  amount            Decimal           @default(0.00) @db.Decimal(12, 2)
  isActive          Boolean           @default(true)
  displayOrder      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId])
}

model PFConfiguration {
  id                String   @id @default(uuid())
  salaryStructureId String   @unique
  employeeRate      Decimal  @default(12.00) @db.Decimal(5, 2)
  employerRate      Decimal  @default(12.00) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
}

model TaxConfiguration {
  id                String   @id @default(uuid())
  salaryStructureId String   @unique
  professionalTax   Decimal  @default(200.00) @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
}

model Payroll {
  id              String        @id @default(uuid())
  employeeId      String
  companyId       String
  periodStart     DateTime
  periodEnd       DateTime
  workingDays     Int
  presentDays     Int
  paidLeaveDays   Int
  unpaidLeaveDays Int
  absentDays      Int
  payableDays     Float
  grossSalary     Float
  totalDeductions Float
  netSalary       Float
  status          PayrollStatus @default(GENERATED)
  generatedBy     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([companyId])
  @@index([employeeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
